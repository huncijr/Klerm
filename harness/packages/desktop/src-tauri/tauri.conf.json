{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Klerm",
	"version": "0.0.1",
	"identifier": "com.klerm.desktop",
	"build": {
		"beforeDevCommand": "node scripts/prepare-desktop.mjs --dev",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "node scripts/prepare-desktop.mjs",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Klerm",
				"width": 1180,
				"height": 760,
				"minWidth": 720,
				"minHeight": 560,
				"center": true,
				"resizable": true,
				"fullscreen": false,
				"backgroundColor": "#080b0f"
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/icon.png", "icons/icon.ico", ".assets/icons/icon.icns"],
		"resources": { ".assets/": "" },
		"macOS": { "minimumSystemVersion": "13.5" },
		"copyright": "Klerm contributors and upstream Pi contributors",
		"category": "DeveloperTool",
		"shortDescription": "Local-first A2A coding agent",
		"longDescription": "Klerm routes coding tasks between local and frontier models while preserving deterministic decision logs."
	}
}
